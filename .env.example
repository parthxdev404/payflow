
# ==========================================
# APPLICATION
# ==========================================
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ==========================================
# FRONTEND / CORS
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# POSTGRESQL
# ==========================================
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/payflow"

# Used only if your Docker Compose configuration references it
POSTGRES_PASSWORD=YOUR_PASSWORD

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRESIN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# ==========================================
# RAZORPAY
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
